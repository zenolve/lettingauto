# =============================================================================
# Palace Gate Lettings — backend configuration
# =============================================================================
# Copy this file to `.env` and fill in real values. Anything marked
# "REPLACE ME" must be set before the corresponding feature works.

# -- App ----------------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO

# -- Auth ---------------------------------------------------------------------
# 32+ char random string. Used to sign agent JWTs + form access tokens.
JWT_SECRET=REPLACE_ME_with_32_plus_random_chars
JWT_TTL_HOURS=12

# Bootstrap agent account created on first run if it doesn't exist.
AGENT_BOOTSTRAP_EMAIL=admin@palacegate.co.uk
AGENT_BOOTSTRAP_PASSWORD=ChangeMeImmediately!

# -- Supabase (Postgres) --------------------------------------------------------
# Hosted Supabase: Settings -> Database -> Connection string (session pooler).
#   e.g. postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
# Apply supabase/migrations/001_init.sql once (SQL Editor) before first run.
# Local dev: docker-compose.dev.yml provides a Postgres on port 54322 with the
# schema auto-applied:
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/lettingauto
SUPABASE_POOL_MAX_SIZE=5
# Optional (Supabase Storage / client APIs later):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -- Stripe ---------------------------------------------------------------------
# Payments via Stripe Checkout. Leave blank to disable (endpoints return 501).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=gbp
# + the one-time new-tenancy fee in pence (GBP 50).
STRIPE_TENANCY_SETUP_FEE_PENCE=5000

# -- Supabase Auth ---------------------------------------------------------
# JWT secret from Supabase -> Settings -> API (verifies agent sign-ins:
# email / Google / Microsoft). Leave blank to run dev-only bootstrap login.
SUPABASE_JWT_SECRET=
# Disable the single-user password login in production.
ALLOW_BOOTSTRAP_LOGIN=true

# -- SMTP ---------------------------------------------------------------------
SMTP_HOST=smtp.zenolve.com
SMTP_PORT=587
SMTP_USER=office@zenolve.com
SMTP_PASS=REPLACE_ME
SMTP_USE_TLS=true
FROM_EMAIL=noreply@palacegate.co.uk
ADMIN_EMAIL=admin@palacegate.co.uk
LESLEY_EMAIL=lesley@palacegate.co.uk

# -- DocuSeal -----------------------------------------------------------------
DOCUSEAL_URL=https://docuseal.palacegate.co.uk
DOCUSEAL_TOKEN=REPLACE_ME
DOCUSEAL_WEBHOOK_SECRET=REPLACE_ME

# Template IDs (confirm with Palace Gate — spec §7.1)
DOCUSEAL_TEMPLATE_OFFER_LETTER=22
DOCUSEAL_TEMPLATE_INSTRUCTION_LETTER=15
DOCUSEAL_TEMPLATE_INTRO_VALUATION=16
DOCUSEAL_TEMPLATE_TERMS_OF_BUSINESS=20
DOCUSEAL_TEMPLATE_PALACE_GATE_DOC=18

# -- Scheduler ----------------------------------------------------------------
SCHEDULER_INTERNAL_TOKEN=REPLACE_ME_with_random_string
