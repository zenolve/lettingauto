# =============================================================================
# Palace Gate Lettings — backend configuration
# =============================================================================
# Copy this file to `.env` and fill in real values. Anything marked
# "REPLACE ME" must be set before the corresponding feature works.

# -- App ----------------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO

# -- Auth ---------------------------------------------------------------------
# 32+ char random string. Used to sign agent JWTs + form access tokens.
JWT_SECRET=REPLACE_ME_with_32_plus_random_chars
JWT_TTL_HOURS=12

# Bootstrap agent account created on first run if it doesn't exist.
AGENT_BOOTSTRAP_EMAIL=admin@palacegate.co.uk
AGENT_BOOTSTRAP_PASSWORD=ChangeMeImmediately!

# -- Airtable -----------------------------------------------------------------
AIRTABLE_TOKEN=REPLACE_ME
AIRTABLE_BASE_ID=appgqHgbJut9LYksm

AIRTABLE_TABLE_PROPERTIES=tblbzHoCEe06wxe24
AIRTABLE_TABLE_LANDLORDS=tblVIXNIkrRp9Xxh2
AIRTABLE_TABLE_TENANTS=tblTenantTableId
AIRTABLE_TABLE_DIARY=tblE9U8jtmI3DTHbJ
AIRTABLE_TABLE_FINANCIALS=tblj71Zu2Jn260nY0
AIRTABLE_TABLE_CHECKLIST=tblGiQey64sUuIp2j
AIRTABLE_TABLE_SUBMISSIONS=tblaflLP7VFCoPMJo
AIRTABLE_TABLE_STAGES=tblIHHIgbF7WbL4bt
AIRTABLE_TABLE_GATE_LOG=tbljoHc7WkcRalZPS
AIRTABLE_TABLE_COMPLIANCE=tblr59bPp9oUusMgJ

# -- SMTP ---------------------------------------------------------------------
SMTP_HOST=smtp.zenolve.com
SMTP_PORT=587
SMTP_USER=office@zenolve.com
SMTP_PASS=REPLACE_ME
SMTP_USE_TLS=true
FROM_EMAIL=noreply@palacegate.co.uk
ADMIN_EMAIL=admin@palacegate.co.uk
LESLEY_EMAIL=lesley@palacegate.co.uk

# -- DocuSeal -----------------------------------------------------------------
DOCUSEAL_URL=https://docuseal.palacegate.co.uk
DOCUSEAL_TOKEN=REPLACE_ME
DOCUSEAL_WEBHOOK_SECRET=REPLACE_ME

# Template IDs (confirm with Palace Gate — spec §7.1)
DOCUSEAL_TEMPLATE_OFFER_LETTER=22
DOCUSEAL_TEMPLATE_INSTRUCTION_LETTER=15
DOCUSEAL_TEMPLATE_INTRO_VALUATION=16
DOCUSEAL_TEMPLATE_TERMS_OF_BUSINESS=20
DOCUSEAL_TEMPLATE_PALACE_GATE_DOC=18

# -- Scheduler ----------------------------------------------------------------
SCHEDULER_INTERNAL_TOKEN=REPLACE_ME_with_random_string
