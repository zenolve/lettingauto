VITE_API_URL=http://localhost:8000
# Supabase Auth (agent sign-in: email/password by default).
# From Supabase -> Settings -> API. Leave blank for the dev bootstrap login.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set true to also show Google / Microsoft sign-in (requires enabling those
# providers in Supabase -> Authentication). Email+password needs no setup.
VITE_ENABLE_OAUTH=false